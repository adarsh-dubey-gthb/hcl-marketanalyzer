# Primary Google Gemini API Key (Get one from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Secondary Fallback Key (Auto-switches silently if primary key hits quota / exhaustion)
GOOGLE_API_KEY_2=your_secondary_gemini_api_key_here

# Tertiary Fallback Key (Auto-switches silently if key 2 hits quota / exhaustion)
GOOGLE_API_KEY_3=your_tertiary_gemini_api_key_here

# Default Gemini Model (e.g. gemini-flash-lite-latest, gemini-3.6-flash, gemini-3.8-flash)
DEFAULT_GEMINI_MODEL=gemini-flash-lite-latest


